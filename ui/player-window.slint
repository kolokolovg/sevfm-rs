// Окно плеера (design D4 add-player-ui, D7 add-album-art). Свойства и
// callbacks связывает main.rs: poll-таймер пишет состояние, play()/stop()
// запускают и останавливают сессию. Обложка — свойство-изображение с
// встроенной заглушкой по умолчанию: main.rs кладёт найденную обложку
// и возвращает заглушку для не-музыки и остановки (правило видимости
// трек-строки).

import { Button } from "std-widgets.slint";

export component PlayerWindow inherits Window {
    // Состояние из poll-таймера.
    in-out property <string> station;
    in-out property <string> status: "Остановлено";
    in-out property <string> artist;
    // `track-title`, а не `title`: title — собственное свойство Window
    // (заголовок), переопределить его нельзя.
    in-out property <string> track-title;
    in-out property <string> error;
    // Обложка текущего трека. Дефолта нет: значение сброса — заглушка
    // из `placeholder-cover`, Rust читает её у окна по мере надобности
    // (в том числе из хендлеров команд трея/MPRIS — держать Image в
    // межпоточных замыканиях нельзя, он не Send).
    in-out property <image> cover;
    // Заглушка обложки: не-музыка (вставка, сырой StreamTitle), промах
    // поиска и сброс на новой сессии.
    in-out property <image> placeholder-cover: @image-url("cover-placeholder.png");
    // Гейты кнопок из UiState: «Играть» — только из «Остановлено».
    in-out property <bool> can-play: true;
    in-out property <bool> can-stop: false;
    // Управление воспроизведением.
    callback play();
    callback stop();

    title: "Говорит Севастополь";
    // Иконка окна (заголовок/таскбар) — единая иконка приложения
    // (герб Севастополя, design D6 add-tray).
    icon: @image-url("app-icon.png");
    preferred-width: 440px;
    preferred-height: 560px;
    background: #14161d;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        // Обложка трека: найденная картинка или заглушка, contain —
        // квадрат без искажений при любых пропорциях картинки.
        Image {
            height: 210px;
            source: root.cover;
            image-fit: ImageFit.contain;
        }

        // Станция.
        Text {
            text: root.station == "" ? "—" : root.station;
            color: #e8eaf2;
            font-size: 22px;
            font-weight: 700;
            horizontal-stretch: 0;
            overflow: elide;
        }

        // Статус.
        Text {
            text: root.status;
            color: #8f97b8;
            font-size: 15px;
        }

        // Трек: исполнитель и название; вставка без исполнителя — только
        // название (строка исполнителя скрыта).
        VerticalLayout {
            spacing: 2px;

            if root.artist != "": Text {
                text: root.artist;
                color: #c6cbde;
                font-size: 16px;
                overflow: elide;
            }

            if root.track-title != "": Text {
                text: root.track-title;
                color: #c6cbde;
                font-size: 16px;
                overflow: elide;
            }
        }

        // Ошибка сессии (фатальная): показывается до следующего «Играть».
        if root.error != "": Rectangle {
            height: 44px;
            border-radius: 8px;
            background: #3a1f26;

            Text {
                text: root.error;
                color: #f0a0b0;
                font-size: 13px;
                overflow: elide;
            }
        }

        Rectangle { vertical-stretch: 1; }

        // Управление: ровно два — «Играть» и «Стоп».
        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            Button {
                text: "Играть";
                enabled: root.can-play;
                clicked => { root.play(); }
            }

            Button {
                text: "Стоп";
                enabled: root.can-stop;
                clicked => { root.stop(); }
            }
        }
    }
}

// Трей (design D1 add-tray): встроенный SystemTrayIcon — значок и меню
// заявляются декларативно, Slint сам строит платформенный бэкенд (ksni
// на Linux, Shell_NotifyIconW на Windows) и перестраивает меню при
// смене свойств. Rust-сторона (main.rs) создаёт компонент, толкает
// свойства из poll-такта и подписывается на колбэки. Tooltip и icon —
// унаследованные свойства SystemTrayIcon, здесь задан стартовый текст.
export component PlayerTray inherits SystemTrayIcon {
    icon: @image-url("app-icon.png");
    // Тултип нативного айтема наружу не экспортируется — обновляется
    // через алиас-свойство из poll-такта.
    in-out property <string> tray-tooltip: "Говорит Севастополь — Остановлено";
    tooltip: root.tray-tooltip;

    // Состояние из poll-такта: гейты пунктов и label переключателя окна.
    in-out property <bool> can-play: true;
    in-out property <bool> can-stop: false;
    in-out property <bool> window-visible: true;

    // Команды — те же хендлеры, что у кнопок окна (design D2);
    // левый клик по значку (нативный clicked) — тоже переключатель.
    callback play();
    callback stop();
    callback toggle-window();
    callback quit();
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: "Играть";
            enabled: root.can-play;
            activated => { root.play(); }
        }
        MenuItem {
            title: "Стоп";
            enabled: root.can-stop;
            activated => { root.stop(); }
        }
        MenuSeparator {}
        MenuItem {
            title: root.window-visible ? "Скрыть окно" : "Показать окно";
            activated => { root.toggle-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Выход";
            activated => { root.quit(); }
        }
    }
}
