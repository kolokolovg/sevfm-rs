// Окно плеера (design D1–D6 redesign-hero-window; история: D4
// add-player-ui, D7 add-album-art, add-lyrics-panel). Свойства и
// callbacks связывает main.rs: poll-таймер пишет состояние,
// play()/stop() запускают и останавливают сессию, toggle-panel()
// переключает панель текста. Композиция «Герой-обложка»: фон — обложка
// трека или заглушка, снизу градиент-затемнение и центрированная
// колонка: статус с индикатором-точкой, главная строка «что в эфире»
// (правило видимости TrackSlot), стеклянные кнопки. Отдельной строки
// станции нет — она живёт в заголовке окна и в заглушке трек-строки.
// Кнопка «Т» при найденном тексте открывает справа панель текста песни,
// и кадр окна расширяется 440→880 (спека player-ui «Фиксированный
// размер окна» в редакции add-lyrics-panel).

// Скролл длинного текста песни (add-lyrics-panel).
import { ScrollView } from "std-widgets.slint";

// Вид индикатора состояния (design D3): Rust пишет производную
// UiState; красный вид окно выводит само из видимой ошибки.
export enum StatusKind {
    playing,
    waiting,
    stopped,
}

// Стеклянная кнопка поверх фона-обложки (design D4): свой компонент
// вместо std-widgets — нативная кнопка не встраивается в композицию.
// «strong» — вариант доступной кнопки (светлая заливка), иконки —
// векторные примитивы без ассетов: Path-треугольник «Играть»,
// квадрат «Стоп».
// Марки-скролл переполненной трек-строки (add-title-artist-scroll):
// строка, не помещающаяся в поле, прокатывается туда-обратно,
// помещающаяся стоит по центру без движения. Гейт enabled у animate
// обязателен: без него бесконечная анимация пинг-понговала бы вокруг
// центра и на короткой строке. Детекция — preferred-width при
// no-wrap: от назначенной ширины не зависит, цикла лэйаута нет (как
// у плашки ошибки). Скорость ~28 px/с, зажата в 3–30 с на проход,
// чтобы длинные названия не «летели». Ширина контейнера приходит
// от layout'а (100% родителя), высота — по тексту.
component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <color> text-color;
    in property <length> text-font-size;
    in property <int> text-font-weight;
    in property <length> text-letter-spacing;

    clip: true;
    height: line.preferred-height;
    property <bool> scrolling: line.preferred-width > root.width;

    line := Text {
        text: root.text;
        color: root.text-color;
        font-size: root.text-font-size;
        font-weight: root.text-font-weight;
        letter-spacing: root.text-letter-spacing;
        wrap: no-wrap;
        overflow: clip;
        width: self.preferred-width;
        x: root.scrolling
            ? (parent.width - self.width)      // крайнее: конец строки целиком
            // покой: помещающаяся строка по центру поля; переполненная
            // (в мёртвой зоне до старта анимации её нет) — у левого
            // края, иначе центр широкой строки давал обрезку с обеих
            // сторон при стоящем тексте
            : max(0px, (parent.width - self.width) / 2);

        animate x {
            enabled: root.scrolling;
            duration: max(3000ms, min(30000ms,
                (self.preferred-width - parent.width) / 1px * 36ms));
            iteration-count: -1;
            direction: alternate;
        }
    }
}

component GlassButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> text;
    in property <bool> strong: false;
    // 0 — «Играть» (треугольник), 1 — «Стоп» (квадрат).
    in property <int> icon-kind: 0;
    // Квадратный формат кнопки «Т» (add-lyrics-panel): фикс 44×44 вместо
    // формулы от контента.
    in property <bool> square: false;
    // Зазор иконка↔текст: свойство, а не литерал — ширится в формулу
    // ширины и в spacing layout'а одним источником (находка ревью
    // oracle: дубль рассинхронился бы при правке).
    property <length> gap: 9px;
    callback clicked();

    height: 44px;
    // Ширина — от контента (поля + иконка + зазор + текст), а не от
    // parent.width: связка «ширина кнопки ← внутренний layout ←
    // parent.width» — цикл, схлопывавший кнопку в ноль (находка
    // ручной приёмки: «Играть» не рисовалась). Квадратная — фикс.
    width: root.square
        ? 44px
        : max(136px, 22px + 13px + root.gap + label.preferred-width + 22px);
    border-radius: self.height / 2;
    opacity: root.enabled ? 1.0 : 0.38;
    border-width: root.strong ? 0px : 1px;
    border-color: rgba(255, 255, 255, 0.22);
    background: root.strong
        ? (ta.pressed ? rgba(255, 255, 255, 0.80) : rgba(255, 255, 255, 0.94))
        : (ta.pressed ? rgba(255, 255, 255, 0.08)
            : ta.has-hover ? rgba(255, 255, 255, 0.18)
            : rgba(255, 255, 255, 0.12));

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: root.gap;

        // Обёртка-центровка: HorizontalLayout растягивает детей по
        // вертикали — иконка исказилась бы без VerticalLayout. Условие
        // стоит на ребёнке layout'а, а не на иконке внутри обёртки:
        // пустой ребёнок всё равно занимает слот и spacing — буква «Т»
        // у квадратной кнопки уезжала на полшага вправо (находка
        // приёмки 5.3).
        if root.icon-kind == 0 && !root.square: VerticalLayout {
            alignment: center;

            Path {
                width: 13px;
                height: 15px;
                viewbox-width: 13;
                viewbox-height: 15;
                commands: "M 0 0 L 13 7.5 L 0 15 Z";
                fill: root.strong ? #14161d : #ffffff;
            }
        }
        if root.icon-kind == 1 && !root.square: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 2px;
                background: root.strong ? #14161d : #ffffff;
            }
        }

        label := Text {
            text: root.text;
            color: root.strong ? #14161d : #ffffff;
            font-size: 15px;
            font-weight: root.strong ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

export component PlayerWindow inherits Window {
    // Состояние из poll-таймера.
    in-out property <string> station;
    in-out property <string> status: "Остановлено";
    // Индикатор состояния (design D3): производная статуса для цвета
    // точки; лейбл остаётся строкой.
    in-out property <StatusKind> status-kind: StatusKind.stopped;
    in-out property <string> artist;
    // `track-title`, а не `title`: title — собственное свойство Window
    // (заголовок), переопределить его нельзя.
    in-out property <string> track-title;
    in-out property <string> error;
    // Обложка текущего трека — фон окна. Дефолта нет: значение сброса —
    // заглушка из `placeholder-cover`, Rust кладёт её при не-музыке и
    // остановке (правило видимости трек-строки).
    in-out property <image> cover;
    // Имя сервиса-источника обложки для ватермарка (design D5
    // add-cover-source-watermark). Пустая строка — обложка без источника
    // (заглушка, старый кеш): плашки нет. Меняется связкой в main.rs
    // строго вместе с `cover` — иначе имя прошлого трека «залипло» бы
    // на чужой обложке (спека player-ui «Ватермарк источника обложки»).
    in-out property <string> cover-source;
    // Заглушка фона: не-музыка (вставка, сырой StreamTitle), промах
    // поиска и сброс на новой сессии.
    in-out property <image> placeholder-cover: @image-url("cover-placeholder.png");
    // Гейты кнопок из UiState: «Играть» — только из «Остановлено».
    in-out property <bool> can-play: true;
    in-out property <bool> can-stop: false;
    // Текст песни (change add-lyrics-panel, спека player-ui «Кнопка „Т"
    // текста песни»/«Панель текста песни»): can-lyrics — кнопка «Т»
    // активна только при найденном тексте; lyrics — содержимое панели;
    // lyrics-source — плашка источника в шапке (симметрия ватермарка
    // обложки); panel-open — состояние панели, им же задаётся ширина
    // кадра (спека «Фиксированный размер окна»: 440×560 ↔ 880×560).
    in-out property <bool> can-lyrics: false;
    in-out property <string> lyrics;
    in-out property <string> lyrics-source;
    in-out property <bool> panel-open: false;
    // Версия сборки в заголовке (просьба пользователя при приёмке
    // add-lyrics-panel): пишет Rust — Slint окружение не читает.
    in-out property <string> app-version;
    // Управление воспроизведением и панелью.
    callback play();
    callback stop();
    callback toggle-panel();

    // Заголовок окна — живое имя станции из icy-name (спека player-ui:
    // в окне оно видно только здесь и в заглушке трек-строки); до его
    // получения и у станций без icy-name — имя приложения (находка
    // ревью hunter: статичный титул врал при запуске с чужим URL).
    // Хвост — только версия сборки (без имени приложения — правка
    // приёмки): имя станции остаётся различимо первым.
    title: (root.station != "" ? root.station : "Говорит Севастополь")
        + " — " + root.app-version;
    // Иконка окна (заголовок/таскбар) — единая иконка приложения
    // (герб Севастополя, design D6 add-tray).
    icon: @image-url("app-icon.png");
    // Фиксированный кадр (спека player-ui «Фиксированный размер окна» в
    // редакции add-lyrics-panel): размер задаётся состоянием панели,
    // пользовательский ресайз запрещён в обоих состояниях (min = max =
    // preferred). Композиция рассчитана на два кадра; расширение и
    // сжатие — при открытии/закрытии панели, без перезапуска.
    preferred-width: root.panel-open ? 880px : 440px;
    preferred-height: 560px;
    min-width: root.panel-open ? 880px : 440px;
    max-width: root.panel-open ? 880px : 440px;
    min-height: 560px;
    max-height: 560px;
    background: #0b0d13;

    // Слои композиции (design D2, уточнение «Карточка» ручной приёмки):
    // тёмная подложка → карточка обложки → градиент → контент. Композиция
    // всегда живёт в левой 440-полосе (add-lyrics-panel): кламп к 440, а
    // не ветка «panel-open ? 440 : root.width» — иначе при закрытии панели
    // состав растягивается на ещё не сжатое окно (880) и сжимается следом:
    // двойная перекомпоновка = видимое дёрганье (находка приёмки 5.3;
    // при открытии дёрганья нет, потому что ветка сразу давала 440).
    Rectangle {
        x: 0;
        y: 0;
        width: min(root.width, 440px);
        height: root.height;

        // Обложка-карточка по центру: 350×350, скругление через clip
        // (у Image нет border-radius), cover — края режутся минимально;
        // заглушка-герб той же карточкой. Мокап «Карточка»: центр на
        // трети высоты окна.
        Rectangle {
            width: 350px;
            height: 350px;
            x: (parent.width - self.width) / 2;
            y: root.height * 0.34 - self.height / 2;
            border-radius: 16px;
            clip: true;
            // drop-shadow снят: в slint 1.19 software-рендерер впервые
            // отливает тени и lint требует для этого background/border,
            // но в 1.18 (принятый вид v0.1.8) тень этим рендерером
            // не рисовалась вовсе — свойства были мёртвыми.

            Image {
                width: 100%;
                height: 100%;
                source: root.cover;
                image-fit: ImageFit.cover;
            }

            // Ватермарк источника (design D5 add-cover-source-watermark,
            // спека player-ui «Ватермарк источника обложки»): условная
            // плашка в правом верхнем углу карточки с отступом 8px.
            // Фон — тот же тёмный тон rgba(11, 13, 19), что у окна и
            // градиента (единая палитра), полупрозрачный — читаем на
            // любых обложках, в отличие от голого текста с тенью.
            // Ширина — от естественной ширины текста: имя сервиса любой
            // длины. Без явной width элемент в Slint занимает 100%
            // родителя — плашка растягивалась на всю карточку (находка
            // ручной приёмки 4.2). Внутренние поля 8px по бокам.
            if root.cover-source != "": Rectangle {
                x: parent.width - self.width - 8px;
                y: 8px;
                height: 21px;
                width: chip-text.preferred-width + 16px;
                border-radius: 8px;
                background: rgba(11, 13, 19, 0.6);

                chip-text := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    vertical-alignment: center;
                    color: white;
                    font-size: 12px;
                    text: root.cover-source;
                }
            }
        }

        // Градиент-затемнение нижней части: читаемость текста на
        // светлых обложках.
        Rectangle {
            x: 0;
            y: parent.height * 0.40;
            width: parent.width;
            height: parent.height * 0.60;
            background: @linear-gradient(180deg,
                rgba(11, 13, 19, 0.0) 0%,
                rgba(11, 13, 19, 0.34) 45%,
                rgba(11, 13, 19, 0.86) 65%,
                #0b0d13 100%);
        }

        // Контент: спейсер прижимает блок к низу, всё по центру.
        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 26px;
            spacing: 12px;

            Rectangle { vertical-stretch: 1; }

            // Статус: точка цвета состояния (красная — при видимой
            // ошибке сессии, design D3) и лейбл.
            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        // Красный — только в паре со статусом «Остановлено»:
                        // транзиентный тик «воркер ещё жив, исход уже Fatal»
                        // не должен перекрашивать точку при «Воспроизведении»
                        // (находка ревью hunter).
                        background: root.error != "" && root.status-kind == StatusKind.stopped ? #e0526a
                            : root.status-kind == StatusKind.playing ? #3fb96b
                            : root.status-kind == StatusKind.waiting ? #e0a63f
                            : #7a8098;
                    }
                }
                Text {
                    text: root.status;
                    color: rgba(255, 255, 255, 0.72);
                    font-size: 13px;
                    font-weight: 500;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
            }

            // Главная строка «что сейчас в эфире» (design D5): трек —
            // артист капсом (Rust пишет uppercase) и название крупно;
            // сырой StreamTitle и заглушка-станция — одна строка (Rust
            // кладёт станцию в track-title, отдельной ветки не нужно —
            // находка ревью hunter: пустой Text резервировал высоту
            // строки, статус прыгал при появлении станции).
            if root.artist != "": MarqueeText {
                text: root.artist;
                text-color: rgba(255, 255, 255, 0.62);
                text-font-size: 13px;
                text-font-weight: 500;
                text-letter-spacing: 1.2px;
            }
            if root.track-title != "": MarqueeText {
                text: root.track-title;
                text-color: #ffffff;
                text-font-size: 25px;
                text-font-weight: 700;
            }

            // Ошибка сессии (фатальная): стеклянная красная плашка до
            // следующего «Играть» (сброс — в command_play). Только в
            // паре со статусом «Остановлено» — см. точку выше.
            if root.error != "" && root.status-kind == StatusKind.stopped: HorizontalLayout {
                alignment: center;

                Rectangle {
                    height: 40px;
                    width: min(error-text.preferred-width + 26px,
                        parent.width);
                    border-radius: 10px;
                    background: rgba(214, 54, 80, 0.22);
                    border-width: 1px;
                    border-color: rgba(255, 122, 142, 0.38);

                    error-text := Text {
                        x: 13px;
                        width: parent.width - 26px;
                        y: (parent.height - self.height) / 2;
                        text: root.error;
                        color: #ffb9c6;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
            }

            // Управление: «Играть», «Стоп» и «Т» (add-lyrics-panel);
            // strong — доступная кнопка (гейты взаимоисключающие).
            // «Т» активна только при найденном тексте; светлая — когда
            // панель открыта (состояние-переключатель, крестика в панели
            // нет — закрытие только повторным «Т»).
            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                GlassButton {
                    text: "Играть";
                    icon-kind: 0;
                    strong: root.can-play;
                    enabled: root.can-play;
                    clicked => { root.play(); }
                }
                GlassButton {
                    text: "Стоп";
                    icon-kind: 1;
                    strong: root.can-stop;
                    enabled: root.can-stop;
                    clicked => { root.stop(); }
                }
                GlassButton {
                    text: "Т";
                    square: true;
                    // Светлая заливка = «текст есть» (конвенция «Играть»:
                    // strong от enabled), буква — тёмная; состояние панели
                    // на вид кнопки не влияет (правка приёмки 5.3).
                    strong: root.can-lyrics;
                    enabled: root.can-lyrics;
                    clicked => { root.toggle-panel(); }
                }
            }
        }
    }

    // Панель текста песни (change add-lyrics-panel, спека player-ui
    // «Панель текста песни»): правая половина расширенного кадра —
    // однотонная тёмная подложка, шапка с плашкой источника, строка
    // трека и сплошной текст со скроллом. Кнопки закрытия нет:
    // закрытие — только повторным «Т» (спека «Кнопка „Т" текста песни»).
    if root.panel-open: Rectangle {
        x: 440px;
        y: 0;
        width: root.width - 440px;
        height: root.height;
        background: #10131c;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.08);

        VerticalLayout {
            padding: 20px;
            spacing: 10px;

            // Шапка: заголовок + плашка источника текста (симметрия
            // ватермарка обложки design D5 add-cover-source-watermark),
            // плашка вплотную к заголовку; ширина — от естественной
            // ширины текста, как у ватермарка обложки (находка приёмки:
            // без явной ширины элемент растягивается на всю строку).
            Rectangle {
                height: 24px;

                header-text := Text {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    text: "ТЕКСТ ПЕСНИ";
                    color: rgba(255, 255, 255, 0.72);
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                }
                if root.lyrics-source != "": Rectangle {
                    x: header-text.preferred-width + 10px;
                    y: (parent.height - self.height) / 2;
                    height: 21px;
                    width: lyrics-chip.preferred-width + 16px;
                    border-radius: 8px;
                    background: rgba(255, 255, 255, 0.08);

                    lyrics-chip := Text {
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                        color: rgba(255, 255, 255, 0.62);
                        font-size: 12px;
                        text: root.lyrics-source;
                    }
                }
            }

            // Строка трека: те же данные, что и главная строка окна
            // (артист уже капсом — пишет связка).
            if root.track-title != "": Text {
                text: root.artist != ""
                    ? root.artist + " — " + root.track-title
                    : root.track-title;
                color: rgba(255, 255, 255, 0.62);
                font-size: 13px;
                // Длинная связка «артист — название» переносится на
                // следующие строки: elide прятал хвост за многоточием
                // (находка приёмки add-title-artist-scroll)
                wrap: word-wrap;
            }

            // Сплошной текст со скроллом, когда не влезает (спека
            // «Прокрутка длинного текста»); пустое содержимое — пустой
            // просмотрщик: текст скрыт при поиске нового трека (спека
            // «Смена трека при открытой панели»). Два биндинга обязательны
            // (находка приёмки 5.3, паттерн textedit-base из std-widgets):
            // ширина текста = видимая ширина вьюпорта (перенос строк), и
            // явная content-height = высота переносного layout'а — иначе
            // Flickable растягивает ребёнка до вьюпорта, запас прокрутки
            // нулевой и полоса не появляется вовсе.
            lyrics-scroll := ScrollView {
                vertical-stretch: 1;
                content-height: max(self.visible-height, lyrics-text.preferred-height);
                // Прокрутка перетаскиванием (просьба приёмки 5.3): виджет
                // по умолчанию глушит drag-pan — только колесо; зажать
                // кнопку на тексте и тянуть тоже должно скроллить.
                mouse-drag-pan-enabled: true;

                lyrics-text := Text {
                    width: lyrics-scroll.visible-width;
                    text: root.lyrics;
                    wrap: word-wrap;
                    color: rgba(255, 255, 255, 0.62);
                    font-size: 15px;
                }
            }
        }
    }
}

// Трей (design D1 add-tray): встроенный SystemTrayIcon — значок и меню
// заявляются декларативно, Slint сам строит платформенный бэкенд (ksni
// на Linux, Shell_NotifyIconW на Windows) и перестраивает меню при
// смене свойств. Rust-сторона (main.rs) создаёт компонент, толкает
// свойства из poll-такта и подписывается на колбэки. Tooltip и icon —
// унаследованные свойства SystemTrayIcon, здесь задан стартовый текст.
export component PlayerTray inherits SystemTrayIcon {
    // Отдельная маленькая иконка, не app-icon.png (256×256): ksni-бэкенд
    // Slint сериализует пиксели иконки трея в D-Bus, оборачивая каждый байт
    // в отдельный zvariant Value — 256×256 раздувается в два блока по 16 МБ
    // (замер gdb/addr2line живого процесса 0.1.2: Vec<Value>::from_iter по
    // ksni::tray::Icon). 48×48 достаточно для отрисовки в трее (~22 px) и
    // сокращает эти блоки до ~0.5 МБ; окно по-прежнему на полной иконке.
    icon: @image-url("tray-icon.png");
    // Тултип нативного айтема наружу не экспортируется — обновляется
    // через алиас-свойство из poll-такта.
    in-out property <string> tray-tooltip: "Говорит Севастополь — Остановлено";
    tooltip: root.tray-tooltip;

    // Состояние из poll-такта: гейты пунктов и label переключателя окна.
    in-out property <bool> can-play: true;
    in-out property <bool> can-stop: false;
    in-out property <bool> window-visible: true;

    // Команды — те же хендлеры, что у кнопок окна (design D2);
    // левый клик по значку (нативный clicked) — тоже переключатель.
    callback play();
    callback stop();
    callback toggle-window();
    callback quit();
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: "Играть";
            enabled: root.can-play;
            activated => { root.play(); }
        }
        MenuItem {
            title: "Стоп";
            enabled: root.can-stop;
            activated => { root.stop(); }
        }
        MenuSeparator {}
        MenuItem {
            title: root.window-visible ? "Скрыть окно" : "Показать окно";
            activated => { root.toggle-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Выход";
            activated => { root.quit(); }
        }
    }
}
