// Окно плеера (design D1–D6 redesign-hero-window; история: D4
// add-player-ui, D7 add-album-art, add-lyrics-panel). Свойства и
// callbacks связывает main.rs: poll-таймер пишет состояние,
// play()/stop() запускают и останавливают сессию, toggle-panel()
// переключает панель текста. Композиция «Герой-обложка»: фон — обложка
// трека или заглушка, снизу градиент-затемнение и центрированная
// колонка: статус с индикатором-точкой, главная строка «что в эфире»
// (правило видимости TrackSlot), стеклянные кнопки. Отдельной строки
// станции нет — она живёт в заголовке окна и в заглушке трек-строки.
// Кнопка «Т» при найденном тексте открывает справа панель текста песни,
// и кадр окна расширяется 440→880 (спека player-ui «Фиксированный
// размер окна» в редакции add-lyrics-panel).

// Панель текста песни — ScrollView с ВЫКЛЮЧЕННОЙ полосой прокрутки
// (приёмка switcher: листать без видимой полосы — always-off).
import { ScrollView } from "std-widgets.slint";

// Вид индикатора состояния (design D3): Rust пишет производную
// UiState; красный вид окно выводит само из видимой ошибки.
export enum StatusKind {
    playing,
    waiting,
    stopped,
}

// Стеклянная кнопка поверх фона-обложки (design D4): свой компонент
// вместо std-widgets — нативная кнопка не встраивается в композицию.
// «strong» — вариант доступной кнопки: стекло плотнее (glass-strong
// мокапа A), не сплошная белая заливка — в мокапе её не существовало,
// и пара «тёмная невидимая + белая слепящая» читалась как поломка
// (приёмка switcher). Иконки — векторные примитивы без ассетов:
// Path-треугольник «Играть», квадрат «Стоп».
// Марки-скролл переполненной трек-строки (add-title-artist-scroll):
// строка, не помещающаяся в поле, прокатывается туда-обратно,
// помещающаяся стоит по центру без движения. Гейт enabled у animate
// обязателен: без него бесконечная анимация пинг-понговала бы вокруг
// центра и на короткой строке. Детекция — preferred-width при
// no-wrap: от назначенной ширины не зависит, цикла лэйаута нет (как
// у плашки ошибки). Скорость ~28 px/с, зажата в 3–30 с на проход,
// чтобы длинные названия не «летели». Ширина контейнера приходит
// от layout'а (100% родителя), высота — по тексту.
component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <color> text-color;
    in property <length> text-font-size;
    in property <int> text-font-weight;
    in property <length> text-letter-spacing;

    clip: true;
    height: line.preferred-height;
    property <bool> scrolling: line.preferred-width > root.width;

    line := Text {
        text: root.text;
        color: root.text-color;
        font-size: root.text-font-size;
        font-weight: root.text-font-weight;
        letter-spacing: root.text-letter-spacing;
        wrap: no-wrap;
        overflow: clip;
        width: self.preferred-width;
        x: root.scrolling
            ? (parent.width - self.width)      // крайнее: конец строки целиком
            // покой: помещающаяся строка по центру поля; переполненная
            // (в мёртвой зоне до старта анимации её нет) — у левого
            // края, иначе центр широкой строки давал обрезку с обеих
            // сторон при стоящем тексте
            : max(0px, (parent.width - self.width) / 2);

        animate x {
            enabled: root.scrolling;
            duration: max(3000ms, min(30000ms,
                (self.preferred-width - parent.width) / 1px * 36ms));
            iteration-count: -1;
            direction: alternate;
        }
    }
}

component GlassButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> text;
    in property <bool> strong: false;
    // 0 — «Играть» (треугольник), 1 — «Стоп» (квадрат).
    in property <int> icon-kind: 0;
    // Квадратный формат кнопки «Т» (add-lyrics-panel): фикс 44×44 вместо
    // формулы от контента.
    in property <bool> square: false;
    // Круглая иконка без текста (мокап A, change add-station-switcher):
    // транспорт «Играть»/«Стоп» — окружность 64px, назначение по иконке.
    in property <bool> circle: false;
    callback clicked();

    height: root.circle ? 64px : 44px;
    width: root.circle ? 64px : 44px;
    // Скругление: транспорт — окружность (circle), «Т» — скруглённый
    // квадрат 12px (мокап A, .gbtn.t border-radius 12px). Единое
    // height/2 на 44×44 давало окружность и там, где нужен квадрат
    // («кнопка текста круглая», приёмка switcher).
    border-radius: root.circle ? self.height / 2 : 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    // Стекло мокапа A: glass .10 / glass-strong .20, кайма одна и та же;
    // нажатие и наведение ступенчато плотнее. Иконки и текст всегда
    // светлые — тёмных иконок на кнопках в мокапе нет.
    background: root.strong
        ? (ta.pressed ? rgba(255, 255, 255, 0.32)
            : ta.has-hover ? rgba(255, 255, 255, 0.26)
            : rgba(255, 255, 255, 0.20))
        : (ta.pressed ? rgba(255, 255, 255, 0.22)
            : ta.has-hover ? rgba(255, 255, 255, 0.16)
            : rgba(255, 255, 255, 0.10));

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    // Значки центрируются ЯВНО координатами, без layout-слотов: у
    // круглых кнопок текста нет, но любые слоты в HorizontalLayout
    // (пустой Text, spacing) дважды смещали значок от центра (замеры
    // приёмки switcher). Размеры 16×18/15×15 — 13×15 и 12×12 в круге
    // 64px пользователь отверг как «мелко» (замер по кропу). Треугольнику
    // +2px оптики: его центр массы на 1/3 ширины от левого края, и даже
    // рамочно-центрованный он «смотрит» сдвинутым влево (замер: жалоба
    // «не выровнено» при геометрически точных центрах). Недоступная
    // кнопка не гасится целиком (opacity-гашение исчезало с тёмного
    // фона) — приглушается только значок.
    if root.circle && root.icon-kind == 0: Path {
        width: 16px;
        height: 18px;
        viewbox-width: 16;
        viewbox-height: 18;
        commands: "M 0 0 L 16 9 L 0 18 Z";
        x: (parent.width - self.width) / 2 + 2px;
        y: (parent.height - self.height) / 2;
        fill: root.enabled ? #ffffff : rgba(255, 255, 255, 0.45);
    }
    if root.circle && root.icon-kind == 1: Rectangle {
        width: 15px;
        height: 15px;
        border-radius: 2px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.enabled ? rgba(255, 255, 255, 0.85) : rgba(255, 255, 255, 0.45);
    }
    if !root.circle: Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        // «Т» мокапа: включённая — белая буква на glass-strong,
        // выключенная — приглушённая (.gbtn.t color .35).
        color: root.strong ? #ffffff : rgba(255, 255, 255, 0.35);
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Переключатель эфиров (change add-station-switcher): стеклянная
// дорожка из двух сегментов над карточкой обложки. Активный эфир
// выделен светлой заливкой; клик всегда уходит в Rust — no-op по
// активному гасится там же (спека player-ui «Переключатель эфиров»).
component StationSwitcher inherits Rectangle {
    in property <[string]> station-names;
    in property <int> station-index;
    callback switch-station(int);

    height: 34px;
    border-radius: 10px;
    background: rgba(12, 14, 17, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);

    HorizontalLayout {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        spacing: 4px;

        for name[idx] in root.station-names: Rectangle {
            // Равные доли независимо от длины имён (мокап: flex 1).
            // Явная ширина обязательна: stretch делит только ИЗБЫТОК
            // поверх preferred, а preferred у сегментов — от текста,
            // и половины выходили разными («кнопки разной ширины»,
            // приёмка switcher).
            width: (parent.width - (root.station-names.length - 1)
                * parent.spacing) / root.station-names.length;
            border-radius: 7px;
            background: root.station-index == idx ? rgba(255, 255, 255, 0.2) : transparent;

            TouchArea {
                clicked => { root.switch-station(idx); }
            }
            Text {
                text: name;
                width: parent.width;
                color: root.station-index == idx ? #ffffff : rgba(255, 255, 255, 0.62);
                // 13px/700: начертание 600 у рендерера спадает в тонкое
                // и сегмент читался легче мокапа («шрифт не увеличен»,
                // приёмка switcher).
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component PlayerWindow inherits Window {
    // Состояние из poll-таймера.
    in-out property <string> station;
    in-out property <string> status: "Остановлено";
    // Индикатор состояния (design D3): производная статуса для цвета
    // точки; лейбл остаётся строкой.
    in-out property <StatusKind> status-kind: StatusKind.stopped;
    in-out property <string> artist;
    // `track-title`, а не `title`: title — собственное свойство Window
    // (заголовок), переопределить его нельзя.
    in-out property <string> track-title;
    in-out property <string> error;
    // Обложка текущего трека — фон окна. Дефолта нет: значение сброса —
    // заглушка из `placeholder-cover`, Rust кладёт её при не-музыке и
    // остановке (правило видимости трек-строки).
    in-out property <image> cover;
    // Имя сервиса-источника обложки для ватермарка (design D5
    // add-cover-source-watermark). Пустая строка — обложка без источника
    // (заглушка, старый кеш): плашки нет. Меняется связкой в main.rs
    // строго вместе с `cover` — иначе имя прошлого трека «залипло» бы
    // на чужой обложке (спека player-ui «Ватермарк источника обложки»).
    in-out property <string> cover-source;
    // Заглушка фона: не-музыка (вставка, сырой StreamTitle), промах
    // поиска и сброс на новой сессии.
    in-out property <image> placeholder-cover: @image-url("cover-placeholder.png");
    // Гейты кнопок из UiState: «Играть» — только из «Остановлено».
    in-out property <bool> can-play: true;
    in-out property <bool> can-stop: false;
    // Текст песни (change add-lyrics-panel, спека player-ui «Кнопка „Т"
    // текста песни»/«Панель текста песни»): can-lyrics — кнопка «Т»
    // активна только при найденном тексте; lyrics — содержимое панели;
    // lyrics-source — плашка источника в шапке (симметрия ватермарка
    // обложки); panel-open — состояние панели, им же задаётся ширина
    // кадра (спека «Фиксированный размер окна»: 440×560 ↔ 880×560).
    in-out property <bool> can-lyrics: false;
    in-out property <string> lyrics;
    in-out property <string> lyrics-source;
    in-out property <bool> panel-open: false;
    // Версия сборки в заголовке (просьба пользователя при приёмке
    // add-lyrics-panel): пишет Rust — Slint окружение не читает.
    in-out property <string> app-version;
    // Управление воспроизведением и панелью.
    callback play();
    callback stop();
    callback toggle-panel();

    // Переключатель эфиров (change add-station-switcher): имена двух
    // встроенных эфиров пишет Rust из константы; активный индекс —
    // текущий выбор (-1 — пользовательский URL запуска, без выделения).
    in property <[string]> station-names;
    in-out property <int> station-index: -1;
    callback switch-station(int);
    // Цвет свечения фона по активному эфиру (мокап A): янтарный/синий;
    // плавный переход при переключении.
    property <color> station-tint: root.station-index == 1 ? #1c3f6e : #6b4a1e;
    animate station-tint { duration: 250ms; }

    // Заголовок окна — живое имя станции из icy-name (спека player-ui:
    // в окне оно видно только здесь и в заглушке трек-строки); до его
    // получения и у станций без icy-name — имя приложения (находка
    // ревью hunter: статичный титул врал при запуске с чужим URL).
    // Хвост — только версия сборки (без имени приложения — правка
    // приёмки): имя станции остаётся различимо первым.
    title: (root.station != "" ? root.station : "Говорит Севастополь")
        + " — " + root.app-version;
    // Иконка окна (заголовок/таскбар) — единая иконка приложения
    // (герб Севастополя, design D6 add-tray).
    icon: @image-url("app-icon.png");
    // Фиксированный кадр (спека player-ui «Фиксированный размер окна» в
    // редакции add-station-switcher): размер задаётся состоянием панели,
    // пользовательский ресайз запрещён в обоих состояниях (min = max =
    // preferred). Высота 600: полоса статуса и переключателя эфиров над
    // карточкой 350×350 (мокап A реальных пропорций). Расширение и
    // сжатие — при открытии/закрытии панели, без перезапуска.
    preferred-width: root.panel-open ? 880px : 440px;
    preferred-height: 600px;
    min-width: root.panel-open ? 880px : 440px;
    max-width: root.panel-open ? 880px : 440px;
    min-height: 600px;
    max-height: 600px;
    background: #0b0d13;

    // Свечение эфира (мокап A, .win::before) — ЕДИНАЯ тёплая шапка на
    // ВСЁ окно, та же формула, что была у левой колонки (180deg, tint
    // 0% → transparent 62%). На кадре 440 совпадает с прежней колонкой
    // пиксель-в-пиксель; на 880 шапка продолжается и на панель текста —
    // половины читаются одним окном (приёмка: «градиент на окне текста
    // не совпадает с градиентом основного окна»: .72-стекло панели и
    // локальный перелив давали чёрную половину рядом с синей).
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: @linear-gradient(180deg, root.station-tint 0%, transparent 62%);
    }
    // Затемнение к низу поверх свечения (мокап, .win::after) — тоже на
    // всю ширину: низ панели темнеет так же, как низ левой половины.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: @linear-gradient(180deg,
            rgba(16, 18, 22, 0.18) 0%,
            rgba(16, 18, 22, 0.55) 58%,
            rgba(16, 18, 22, 0.94) 100%);
    }

    // Колонка контента (design D2, уточнение «Карточка» ручной
    // приёмки). Композиция всегда живёт в левой 440-полосе
    // (add-lyrics-panel): кламп к 440, а
    // не ветка «panel-open ? 440 : root.width» — иначе при закрытии панели
    // состав растягивается на ещё не сжатое окно (880) и сжимается следом:
    // двойная перекомпоновка = видимое дёрганье (находка приёмки 5.3;
    // при открытии дёрганья нет, потому что ветка сразу давала 440).
    Rectangle {
        x: 0;
        y: 0;
        width: min(root.width, 440px);
        height: root.height;

        // Контент: колонка утверждённого мокапа A (change
        // add-station-switcher) — статус с точкой сверху, под ним
        // переключатель эфиров, карточка обложки 350×350 в центре
        // колонки, под ней трек-строка, внизу транспорт. Высоты сходятся
        // в кадр 600: 20+34+350+52+64 + 4 зазора по 10 + поля 2×20.
        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 20px;
            spacing: 10px;

            // Статус: точка цвета состояния (красная — при видимой
            // ошибке сессии, design D3) и лейбл. По левому краю —
            // композиция утверждённого мокапа A (change
            // add-station-switcher); по умолчанию layout тянет детей
            // влево, явной центровки больше нет.
            HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        // Красный — только в паре со статусом «Остановлено»:
                        // транзиентный тик «воркер ещё жив, исход уже Fatal»
                        // не должен перекрашивать точку при «Воспроизведении»
                        // (находка ревью hunter).
                        background: root.error != "" && root.status-kind == StatusKind.stopped ? #e0526a
                            : root.status-kind == StatusKind.playing ? #3fb96b
                            : root.status-kind == StatusKind.waiting ? #e0a63f
                            : #7a8098;
                    }
                }
                Text {
                    text: root.status;
                    color: rgba(255, 255, 255, 0.72);
                    font-size: 13px;
                    font-weight: 500;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
            }

            // Переключатель эфиров (change add-station-switcher):
            // дорожка из двух сегментов; клик всегда уходит в Rust,
            // no-op по активному гасится там же.
            StationSwitcher {
                station-names: root.station-names;
                station-index: root.station-index;
                switch-station(idx) => { root.switch-station(idx); }
            }

            // Карточка обложки: 350×350, скругление через clip (у Image
            // нет border-radius), cover — края режутся минимально;
            // заглушка-герб той же карточкой. Обёртка с stretch 1: карман
            // в пару пикселей от неточных метрик шрифта уходит в неё,
            // не двигая остальные строки.
            HorizontalLayout {
                alignment: center;
                vertical-stretch: 1;

                Rectangle {
                    width: 350px;
                    height: 350px;
                    border-radius: 16px;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.cover;
                        image-fit: ImageFit.cover;
                    }

                    // Ватермарк источника (design D5
                    // add-cover-source-watermark, спека player-ui
                    // «Ватермарк источника обложки»): плашка в правом
                    // верхнем углу карточки; ширина — от естественной
                    // ширины текста (без явной width элемент занимает 100%
                    // родителя — находка ручной приёмки 4.2).
                    if root.cover-source != "": Rectangle {
                        x: parent.width - self.width - 8px;
                        y: 8px;
                        height: 21px;
                        width: chip-text.preferred-width + 16px;
                        border-radius: 8px;
                        background: rgba(11, 13, 19, 0.6);

                        chip-text := Text {
                            x: 8px;
                            width: parent.width - 16px;
                            vertical-alignment: center;
                            color: white;
                            font-size: 12px;
                            text: root.cover-source;
                        }
                    }
                }
            }

            // Главная строка «что сейчас в эфире» (design D5) в слоте
            // фиксированной высоты: появление и пропадание трека не
            // двигают композицию (урок находки ревью hunter — пустой
            // Text резервировал высоту, статус прыгал). Трек — артист
            // капсом (Rust пишет uppercase) и название крупно; сырой
            // StreamTitle и заглушка-станция — одна строка (Rust кладёт
            // станцию в track-title, отдельной ветки не нужно).
            // Ошибка сессии (фатальная) — на месте трек-строки: они не
            // видны вместе (ошибка — «Остановлено», трек погашен),
            // красная плашка до следующего «Играть» (сброс — в
            // command_play).
            Rectangle {
                height: 52px;

                VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    spacing: 5px;

                    if root.artist != "": MarqueeText {
                        text: root.artist;
                        text-color: rgba(255, 255, 255, 0.62);
                        text-font-size: 13px;
                        text-font-weight: 500;
                        text-letter-spacing: 1.2px;
                    }
                    if root.track-title != "": MarqueeText {
                        text: root.track-title;
                        text-color: #ffffff;
                        text-font-size: 25px;
                        text-font-weight: 700;
                    }
                }

                if root.error != "" && root.status-kind == StatusKind.stopped: HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    alignment: center;

                    Rectangle {
                        height: 40px;
                        width: min(error-text.preferred-width + 26px,
                            parent.width);
                        border-radius: 10px;
                        background: rgba(214, 54, 80, 0.22);
                        border-width: 1px;
                        border-color: rgba(255, 122, 142, 0.38);

                        error-text := Text {
                            x: 13px;
                            width: parent.width - 26px;
                            y: (parent.height - self.height) / 2;
                            text: root.error;
                            color: #ffb9c6;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                }
            }

            // Управление (мокап A): «Играть» и «Стоп» — круглые иконки,
            // «Т» — скруглённый квадрат (add-lyrics-panel); strong —
            // доступная кнопка (гейты взаимоисключающие). «Т» активна
            // только при найденном тексте; состояние панели на вид
            // кнопки не влияет (правка приёмки 5.3).
            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                GlassButton {
                    icon-kind: 0;
                    circle: true;
                    strong: root.can-play;
                    enabled: root.can-play;
                    clicked => { root.play(); }
                }
                GlassButton {
                    icon-kind: 1;
                    circle: true;
                    strong: root.can-stop;
                    enabled: root.can-stop;
                    clicked => { root.stop(); }
                }
                // Обёртка-центровка по вертикали: HorizontalLayout ставит
                // детей с фиксированной высотой у ВЕРХНЕГО края ряда
                // (замер приёмки switcher: «Т» на ~10px выше кругов).
                // Обёртка растягивается на высоту ряда и центрирует
                // кнопку 44px.
                VerticalLayout {
                    alignment: center;

                    GlassButton {
                        text: "Т";
                        square: true;
                        // Плотное стекло = «текст есть» (конвенция
                        // strong от enabled); состояние панели на вид
                        // кнопки не влияет (правка приёмки 5.3).
                        strong: root.can-lyrics;
                        enabled: root.can-lyrics;
                        clicked => { root.toggle-panel(); }
                    }
                }
            }
        }
    }

    // Панель текста песни (change add-lyrics-panel, спека player-ui
    // «Панель текста песни»): правая половина расширенного кадра —
    // шапка с плашкой источника, строка трека и сплошной текст со
    // скроллом. Кнопки закрытия нет: закрытие — только повторным «Т»
    // (спека «Кнопка „Т" текста песни»). Подложки и рамки нет (раунд 8
    // приёмки switcher: «градиент на окне текста не совпадает с
    // основным окном» — .72-стекло и локальный перелив читались чёрной
    // половиной рядом с цветной): панель — прозрачное продолжение общих
    // слоёв окна, шапка свечения и затемнение идут через неё без шва.
    if root.panel-open: Rectangle {
        x: 440px;
        y: 0;
        width: root.width - 440px;
        height: root.height;

        VerticalLayout {
            padding: 20px;
            spacing: 10px;

            // Шапка: заголовок + плашка источника текста (симметрия
            // ватермарка обложки design D5 add-cover-source-watermark),
            // плашка вплотную к заголовку; ширина — от естественной
            // ширины текста, как у ватермарка обложки (находка приёмки:
            // без явной ширины элемент растягивается на всю строку).
            Rectangle {
                height: 24px;

                header-text := Text {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    text: "ТЕКСТ ПЕСНИ";
                    color: rgba(255, 255, 255, 0.72);
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                }
                if root.lyrics-source != "": Rectangle {
                    x: header-text.preferred-width + 10px;
                    y: (parent.height - self.height) / 2;
                    height: 21px;
                    width: lyrics-chip.preferred-width + 16px;
                    border-radius: 8px;
                    background: rgba(255, 255, 255, 0.08);

                    lyrics-chip := Text {
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                        color: rgba(255, 255, 255, 0.62);
                        font-size: 12px;
                        text: root.lyrics-source;
                    }
                }
            }

            // Строка трека: те же данные, что и главная строка окна
            // (артист уже капсом — пишет связка).
            if root.track-title != "": Text {
                text: root.artist != ""
                    ? root.artist + " — " + root.track-title
                    : root.track-title;
                color: rgba(255, 255, 255, 0.62);
                font-size: 13px;
                // Длинная связка «артист — название» переносится на
                // следующие строки: elide прятал хвост за многоточием
                // (находка приёмки add-title-artist-scroll)
                wrap: word-wrap;
            }

            // Прокрутка текста колесом и перетаскиванием БЕЗ видимой
            // полосы: у ScrollView есть штатный выключатель полосы
            // (vertical-scrollbar-policy: always-off) — попытка заменить
            // виджет голым Flickable умерла дважды: сначала диапазон
            // прокрутки (content-height — свойство самого Flickable,
            // дефолт считает только layout-детей; Text не layout —
            // листать было нечего), затем живое мерцание при прокрутке
            // (приёмка switcher). Возврат к проверенному с 0.1.8
            // паттерну двух биндингов + policy.
            lyrics-scroll := ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                mouse-drag-pan-enabled: true;
                content-height: max(self.visible-height, lyrics-text.preferred-height);

                lyrics-text := Text {
                    width: lyrics-scroll.visible-width;
                    text: root.lyrics;
                    wrap: word-wrap;
                    color: rgba(255, 255, 255, 0.62);
                    font-size: 15px;
                }
            }
        }
    }
}

// Трей (design D1 add-tray): встроенный SystemTrayIcon — значок и меню
// заявляются декларативно, Slint сам строит платформенный бэкенд (ksni
// на Linux, Shell_NotifyIconW на Windows) и перестраивает меню при
// смене свойств. Rust-сторона (main.rs) создаёт компонент, толкает
// свойства из poll-такта и подписывается на колбэки. Tooltip и icon —
// унаследованные свойства SystemTrayIcon, здесь задан стартовый текст.
export component PlayerTray inherits SystemTrayIcon {
    // Отдельная маленькая иконка, не app-icon.png (256×256): ksni-бэкенд
    // Slint сериализует пиксели иконки трея в D-Bus, оборачивая каждый байт
    // в отдельный zvariant Value — 256×256 раздувается в два блока по 16 МБ
    // (замер gdb/addr2line живого процесса 0.1.2: Vec<Value>::from_iter по
    // ksni::tray::Icon). 48×48 достаточно для отрисовки в трее (~22 px) и
    // сокращает эти блоки до ~0.5 МБ; окно по-прежнему на полной иконке.
    icon: @image-url("tray-icon.png");
    // Тултип нативного айтема наружу не экспортируется — обновляется
    // через алиас-свойство из poll-такта.
    in-out property <string> tray-tooltip: "Говорит Севастополь — Остановлено";
    tooltip: root.tray-tooltip;

    // Состояние из poll-такта: гейты пунктов и label переключателя окна.
    in-out property <bool> can-play: true;
    in-out property <bool> can-stop: false;
    in-out property <bool> window-visible: true;

    // Команды — те же хендлеры, что у кнопок окна (design D2);
    // левый клик по значку (нативный clicked) — тоже переключатель.
    callback play();
    callback stop();
    callback toggle-window();
    callback quit();
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: "Играть";
            enabled: root.can-play;
            activated => { root.play(); }
        }
        MenuItem {
            title: "Стоп";
            enabled: root.can-stop;
            activated => { root.stop(); }
        }
        MenuSeparator {}
        MenuItem {
            title: root.window-visible ? "Скрыть окно" : "Показать окно";
            activated => { root.toggle-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Выход";
            activated => { root.quit(); }
        }
    }
}
